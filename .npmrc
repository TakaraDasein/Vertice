# Configuración de pnpm para versiones exactas
# Guardar las versiones exactas sin prefijos ^ o ~
save-exact=true

# Usar hoisting para compatibilidad con Next.js
shamefully-hoist=true

# Comportamiento estricto de peer dependencies
strict-peer-dependencies=false

# Auto instalar peers si es necesario
auto-install-peers=true

# Lockfile estricto (sin actualizaciones automáticas)
lockfile=true

# Registros públicos
registry=https://registry.npmjs.org/
